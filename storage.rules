rules_version = '2';

// Mirrors the Firestore membership check. Attachments: images or PDF up to
// 10 MB, written by editors. Generated documents: PDF up to 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function memberDoc(bid) {
      return /databases/(default)/documents/businesses/$(bid)/members/$(request.auth.uid);
    }
    function member(bid) {
      return request.auth != null && firestore.exists(memberDoc(bid));
    }
    function editor(bid) {
      return member(bid) && firestore.get(memberDoc(bid)).data.role in ['owner', 'admin', 'editor'];
    }
    function underLimit() { return request.resource.size <= 10 * 1024 * 1024; }

    match /businesses/{bid}/attachments/{tid}/{file} {
      allow read: if member(bid);
      allow create: if editor(bid) && underLimit()
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if editor(bid);
      allow update: if false;
    }

    match /businesses/{bid}/documents/{file} {
      allow read: if member(bid);
      allow create: if editor(bid) && underLimit() && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
